# Opzionale: telemetria anonima Next.js (https://nextjs.org/telemetry)
# NEXT_TELEMETRY_DISABLED=1

# Copia in `.env.local` solo quando collegare i servizi (mai committare `.env.local`).
# Valori segnaposto — sostituire con chiavi reali solo in ambiente controllato.

# ANTHROPIC_API_KEY=
# Stripe (Checkout + webhook) — abilita /api/create-checkout e pagamento reale
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Opzionale lato client se in futuro servirà Elements:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Anthropic — report LLM (senza chiave: /api/generate-report restituisce markdown demo dopo pagamento)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Prezzo report in centesimi EUR (499 = 4,99 €)
REPORT_PRICE_EUR=499
